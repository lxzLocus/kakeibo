# docker-compose.prod.yml 用の環境変数サンプル。
# `cp .env.example .env` して値を設定する（.env は .gitignore 済み・コミットしない）。

# DB のパスワード（app と mysql の両方に効く）
DB_PASSWORD=change-me-strong-password

# 保存済み LLM API キーの暗号化に使う。運用中は絶対に変えないこと（変えると復号不能になる）。
# 例: openssl rand -hex 16 などで生成
APP_ENCRYPTION_PASSWORD=change-me-encryption-password
APP_ENCRYPTION_SALT=0123456789abcdef

# CI(GHCR) 済みイメージを使う場合に指定（未指定ならローカルビルド kakeibo:local）
# IMAGE=ghcr.io/lxzlocus/kakeibo:latest

# --- アクセスゲート（外部公開時の最低限の認証） ---
# 両方セットすると、フロント(Next.js middleware)が全リクエストに Basic 認証を要求する。
# 未設定（空）ならゲート無効＝誰でもアクセス可（ローカル開発の既定）。
# staging/本番で外部公開するなら必ず設定すること。
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-strong-password
